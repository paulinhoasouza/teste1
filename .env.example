# Sem estas variáveis o app abre em modo de demonstração, com dados de exemplo.

# Endereço do projeto no Supabase (Settings → API), como https://xxxx.supabase.co
SUPABASE_URL=

# Chave publicável do projeto (sb_publishable_...).
SUPABASE_KEY=

# Segredo próprio do app. O banco só responde a pedidos que trazem este valor;
# o SHA-256 dele fica gravado na função privado.pedido_autorizado().
BANCO_SEGREDO=

# Opcional. Se definida, o app pede esta senha na entrada.
# Sem ela, o acesso fica por conta da proteção da Vercel (Deployment Protection).
APP_SENHA=
