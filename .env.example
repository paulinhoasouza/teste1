# Sem estas variáveis o app abre em modo de demonstração, com dados de exemplo.

# Conteúdo inteiro do arquivo .json da chave da conta de serviço do Google.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Endereço (ou só o id) da planilha compartilhada com a conta de serviço.
GOOGLE_SHEET_ID=

# Senha que vocês dois digitam para entrar. Obrigatória quando a planilha está ligada.
APP_SENHA=
